---
import { site } from '@/config/site';
---

<section id="sobre-mi" class="container section">
	<h2>Sobre mí</h2>
	<p class="bio">
		Escribe aquí un párrafo breve sobre ti: qué haces, qué te interesa y qué tipo de proyectos buscas.
	</p>
	<ul class="skills">
		{site.skills.map((skill) => <li>{skill}</li>)}
	</ul>
</section>

<style>
	.bio {
		max-width: 40rem;
		color: var(--muted);
	}
	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		font-family: var(--font-mono);
		font-size: 0.875rem;
	}
	.skills li {
		padding: 0.3rem 0.75rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 0.5rem;
	}
</style>
