---
import { site } from '@/config/site';
import NfcFigure from '@/components/project-nfc/Figure.astro';
---

<section id="proyectos" class="container section">
	<h2>Proyectos</h2>
	<article class="staff-project">
		<div>
			<h3>Staff App</h3>
			<p>Aplicación para registrar accesos en eventos mediante gafetes NFC.</p>
			<ul class="tags"><li>Flutter</li><li>NFC</li><li>Supabase</li></ul>
		</div>
		<NfcFigure />
	</article>
	<ul class="grid">
		{site.projects.map((project) => (
			<li class="card">
				<h3>{project.title}</h3>
				<p>{project.description}</p>
				<ul class="tags">
					{project.tags.map((tag) => <li>{tag}</li>)}
				</ul>
				<div class="links">
					{project.url && <a href={project.url} aria-label={`Demo de ${project.title}`}>Demo</a>}
					{project.repo && <a href={project.repo} aria-label={`Código de ${project.title}`}>Código</a>}
				</div>
			</li>
		))}
	</ul>
</section>

<style>
	.staff-project {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		align-items: center;
		gap: 2.5rem;
		margin-bottom: 1.25rem;
	}
	@media (max-width: 768px) {
		.staff-project { grid-template-columns: 1fr; gap: 1rem; }
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.card {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		background: var(--surface);
	}
	h3 {
		margin: 0 0 0.5rem;
	}
	p {
		color: var(--muted);
		margin: 0 0 1rem;
		flex: 1;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}
	.tags li {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 999px;
	}
	.links {
		display: flex;
		gap: 1rem;
	}
</style>
