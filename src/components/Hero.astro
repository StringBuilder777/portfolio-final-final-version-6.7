---
import { site } from '@/config/site';
import wiredIntelligence from '@/lib/ascii/wired-intelligence';

const still = wiredIntelligence({ speed: 0 })(0);
---

<section class="hero" aria-labelledby="hero-name">
	<div class="hero-art" data-hero-ascii aria-hidden="true"><pre>{still}</pre></div>
	<div class="container hero-content">
	<p class="eyebrow">Hola, soy</p>
	<h1 id="hero-name">{site.name}</h1>
	<p class="role">{site.role}</p>
	<p class="lead">{site.description}</p>
	<div class="actions">
		<a class="btn primary" href="/proyectos/">Ver proyectos</a>
		<a class="btn" href="/contacto/">Contacto</a>
	</div>
	</div>
</section>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-hero-ascii]')) {
		const observer = new IntersectionObserver(async (entries) => {
			if (!entries.some(entry => entry.isIntersecting)) return;
			observer.disconnect();
			try {
				const [{ mount }, piece] = await Promise.all([import('ascii.rest'), import('@/lib/ascii/wired-intelligence')]);
				const canvas = document.createElement('canvas');
				root.replaceChildren(canvas);
				mount(canvas, piece, { speed: 1, fps: 15 });
				root.dataset.ready = 'true';
			} catch { /* El primer fotograma y la presentación permanecen disponibles. */ }
		});
		observer.observe(root);
	}
</script>

<style>
	.hero {
		--bg: #080706;
		--fg: #fffef8;
		--muted: #d0ccc4;
		--accent: #f2cc9e;
		--border: #ffffff50;
		position: relative;
		isolation: isolate;
		display: grid;
		align-items: center;
		min-height: clamp(32rem, 78svh, 46rem);
		padding-block: clamp(3rem, 8vw, 7rem);
		overflow: hidden;
		background: var(--bg);
		color: var(--fg);
	}
	.hero::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(90deg, #080706f0 0%, #080706ca 38%, #08070665 68%, #08070630 100%); }
	.hero-art { position: absolute; inset: 0; z-index: -2; container-type: size; overflow: hidden; pointer-events: none; color: #b2b0ab; }
	.hero-art pre { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); margin: 0; width: max-content; font: max(calc(100cqw / 192), calc(100cqh / 108))/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: pre; opacity: 0.85; }
	.hero-art :global(canvas) { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: max(100cqw, calc(100cqh * 16 / 9)) !important; height: auto; max-width: none; opacity: 0.9; }
	.hero-content { position: relative; }
	.eyebrow {
		font-family: var(--font-mono);
		color: var(--accent);
		margin: 0;
	}
	h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		line-height: 1.1;
		margin: 0.25rem 0;
		max-width: 14ch;
		text-wrap: balance;
	}
	.role {
		font-size: 1.25rem;
		color: var(--muted);
		margin: 0 0 1rem;
	}
	.lead {
		max-width: 40rem;
	}
	.actions {
		display: flex;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.btn {
		padding: 0.6rem 1.2rem;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		color: var(--fg);
		text-decoration: none;
	}
	.btn.primary {
		background: var(--fg);
		color: var(--bg);
		border-color: var(--fg);
	}
	@media(max-width: 600px) {
		.hero { min-height: 34rem; }
		.hero::after { background: linear-gradient(90deg, #080706e8, #080706b0); }
	}
</style>
