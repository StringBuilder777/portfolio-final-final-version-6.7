---
import { site } from '@/config/site';
---

<section class="container hero">
	<p class="eyebrow">Hola, soy</p>
	<h1>{site.name}</h1>
	<p class="role">{site.role}</p>
	<p class="lead">{site.description}</p>
	<div class="actions">
		<a class="btn primary" href="#proyectos">Ver proyectos</a>
		<a class="btn" href="#contacto">Contacto</a>
	</div>
</section>

<style>
	.hero {
		padding-block: 6rem 4rem;
	}
	.eyebrow {
		font-family: var(--font-mono);
		color: var(--accent);
		margin: 0;
	}
	h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		line-height: 1.1;
		margin: 0.25rem 0;
	}
	.role {
		font-size: 1.25rem;
		color: var(--muted);
		margin: 0 0 1rem;
	}
	.lead {
		max-width: 40rem;
	}
	.actions {
		display: flex;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.btn {
		padding: 0.6rem 1.2rem;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		color: var(--fg);
		text-decoration: none;
	}
	.btn.primary {
		background: var(--fg);
		color: var(--bg);
		border-color: var(--fg);
	}
</style>
