---
import { site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container inner">
		<p>© {year} {site.name} · <a href="/licenses/anatomy.txt">Licencias</a></p>
		<ul>
			{site.links.map((link) => (
				<li><a href={link.href} rel="noopener noreferrer" target="_blank">{link.label}</a></li>
			))}
		</ul>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--border);
		padding-block: 2rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	p {
		margin: 0;
	}
	ul {
		display: flex;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
