---
import { site } from '@/config/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="header">
	<nav class="container nav" aria-label="Principal">
		<a href="/" class="brand">{site.name}</a>
		<ul>
			{site.nav.map((item) => (
				<li><a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a></li>
			))}
		</ul>
		<ThemeToggle />
	</nav>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 5;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border);
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		min-height: 3.5rem;
		padding-block: 0.75rem;
		flex-wrap: wrap;
	}
	.brand {
		font-weight: 600;
		color: var(--fg);
		text-decoration: none;
		margin-right: auto;
	}
	ul {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	ul a {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
	}
	ul a:hover, ul a[aria-current="page"] {
		color: var(--fg);
	}
	@media (max-width: 1000px) {
		.nav {
			gap: 0.75rem;
		}
		.brand { font-size: 0.85rem; }
		ul {
			gap: 1.1rem;
			order: 3;
			width: 100%;
			padding-bottom: 0.25rem;
			overflow-x: auto;
			white-space: nowrap;
		}
	}
</style>
