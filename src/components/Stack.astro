---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { site } from '@/config/site';
import typescript, { meta as typescriptMeta } from 'ascii.rest/pieces/typescript';
import php, { meta as phpMeta } from 'ascii.rest/pieces/php';
import javascript, { meta as javascriptMeta } from 'ascii.rest/pieces/javascript';
import html, { meta as htmlMeta } from 'ascii.rest/pieces/html';
import css, { meta as cssMeta } from 'ascii.rest/pieces/css';
import java, { meta as javaMeta } from 'ascii.rest/pieces/java';
import rust, { meta as rustMeta } from 'ascii.rest/pieces/rust';
import lua, { meta as luaMeta } from 'ascii.rest/pieces/lua';
import c, { meta as cMeta } from 'ascii.rest/pieces/c';

const frontendLogos = [
 { name: 'typescript', frame: typescript, meta: typescriptMeta },
 { name: 'php', frame: php, meta: phpMeta },
 { name: 'javascript', frame: javascript, meta: javascriptMeta },
 { name: 'html', frame: html, meta: htmlMeta },
 { name: 'css', frame: css, meta: cssMeta },
];
const backendLogos = [
 { name: 'java', frame: java, meta: javaMeta },
 { name: 'rust', frame: rust, meta: rustMeta },
 { name: 'lua', frame: lua, meta: luaMeta },
 { name: 'c', frame: c, meta: cMeta },
];

// Cada figura vive en src/components/figures/<id>/Figure.astro y se detecta sola.
// Mientras no exista, se muestra un hueco; .figure-slot fija la proporción para ambos casos.
const modules = import.meta.glob<{ default: AstroComponentFactory }>('./figures/*/Figure.astro', {
	eager: true,
});
const figures = Object.fromEntries(
	Object.entries(modules).map(([path, mod]) => [path.split('/')[2], mod.default]),
);

const ids = new Set<string>(site.stack.map((area) => area.id));
for (const id of Object.keys(figures)) {
	if (!ids.has(id)) console.warn(`[stack] figures/${id}/ no corresponde a ningún área de site.stack; se ignora.`);
}
---

<section id="stack" class="container section">
 <h2>Stack</h2>
 <p>Selecciona un diagrama para explorar sus tecnologías.</p>
 <ol class="areas">
  {site.stack.map((area) => {
   const Figure = figures[area.id];
   const logos = area.id === 'frontend' ? frontendLogos : area.id === 'backend' ? backendLogos : [];
   const asciiPiece = area.id === 'frontend' ? 'earthrise' : area.id === 'redes' ? 'edge-orbit' : area.id === 'backend' ? 'green-storm' : null;
   return <li class="area" id={`stack-${area.id}`}>
    <div class="preview">
     {logos.map(logo => <div class="preview-logo" data-preview-logo={logo.name} aria-hidden="true" style={`aspect-ratio:${logo.meta.cols}/${logo.meta.rows * 2};--logo-font:${100 / (logo.meta.cols * 0.6)}cqw`}><pre>{logo.frame({ shine: 5 })(0)}</pre></div>)}
     <div class="figure-slot" data-figure-home={area.id}>
      {Figure ? <Figure /> : <div class="placeholder">{area.title}<small>Diagrama próximamente</small></div>}
     </div>
     <button type="button" class="open-area" data-open-area={area.id} aria-haspopup="dialog" aria-controls={`dialog-${area.id}`} aria-label={`Explorar ${area.title}`}><span>{area.title}</span></button>
    </div>
    <dialog id={`dialog-${area.id}`} class:list={["stack-dialog", { "ascii-scene": Boolean(asciiPiece) }]} aria-labelledby={`title-${area.id}`}>
     {asciiPiece && <div class="ascii-background" data-ascii-background data-piece={asciiPiece} data-earthrise={area.id === 'frontend' ? '' : undefined} aria-hidden="true"></div>}
     <form method="dialog"><button class="close-area" aria-label={`Cerrar ${area.title}`}>Cerrar</button></form>
     <div class="detail-layout">
      <div class="diagram-view">
       <div class="figure-slot expanded-figure" data-figure-target={area.id}>
        <div class="figure-original"></div>
       </div>
      </div>
      <div class="text">
       <h3 id={`title-${area.id}`}>{area.title}</h3>
       <p>{area.summary}</p>
       <ul class="techs">{area.techs.map((tech) => <li>{area.id === 'redes' && (tech === 'Cisco IOS' || tech === 'Packet Tracer') ? <button type="button" class="tech-button" data-network-detail={tech}>{tech}</button> : tech}</li>)}</ul>
      </div>
     </div>
    </dialog>
   </li>;
  })}
 </ol>
</section>
<script>
 const logoPieces = {
  typescript: () => import('ascii.rest/pieces/typescript'),
  php: () => import('ascii.rest/pieces/php'),
  javascript: () => import('ascii.rest/pieces/javascript'),
  html: () => import('ascii.rest/pieces/html'),
  css: () => import('ascii.rest/pieces/css'),
  java: () => import('ascii.rest/pieces/java'),
  rust: () => import('ascii.rest/pieces/rust'),
  lua: () => import('ascii.rest/pieces/lua'),
  c: () => import('ascii.rest/pieces/c'),
 };
 for (const logo of document.querySelectorAll<HTMLElement>('[data-preview-logo]')) {
  const name = logo.dataset.previewLogo;
  if (!name || !(name in logoPieces)) continue;
  const load = logoPieces[name as keyof typeof logoPieces];
  const observer = new IntersectionObserver(async (entries) => {
   if (!entries.some(entry => entry.isIntersecting)) return;
   observer.disconnect();
   try {
    const [{ mount }, piece] = await Promise.all([import('ascii.rest'), load()]);
    const canvas = document.createElement('canvas');
    logo.replaceChildren(canvas);
    mount(canvas, piece, { shine: 5, fps: 15 });
   } catch { /* Conservar el primer fotograma si no se puede cargar la animación. */ }
  });
  observer.observe(logo);
 }
 for (const button of document.querySelectorAll<HTMLButtonElement>('[data-open-area]')) {
  const id = button.dataset.openArea!;
  const dialog = document.getElementById(`dialog-${id}`) as HTMLDialogElement;
  const home = document.querySelector<HTMLElement>(`[data-figure-home="${id}"]`)!;
  const target = dialog.querySelector<HTMLElement>('[data-figure-target]')!;
  const original = target.querySelector<HTMLElement>('.figure-original')!;
  const background = dialog.querySelector<HTMLElement>('[data-ascii-background]');
  let stopBackground: (() => void) | null = null;
  let generation = 0;
  button.addEventListener('click', async () => {
   const request = ++generation;
   const source = home.getBoundingClientRect();
   original.append(...Array.from(home.childNodes));
   dialog.showModal(); dialog.scrollTop = 0;
   document.documentElement.style.overflow = 'hidden';
   if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const end = target.getBoundingClientRect();
    target.animate([{ transformOrigin: '0 0', transform: `translate(${source.x-end.x}px, ${source.y-end.y}px) scale(${source.width/end.width})`, opacity: 0.5 }, { transformOrigin: '0 0', transform: 'none', opacity: 1 }], { duration: 450, easing: 'cubic-bezier(.2,.7,.2,1)' });
   }
   if (background) {
    try {
     const [{ mount }, piece] = await Promise.all([import('ascii.rest'),
      id === 'redes' ? import('@/lib/ascii/edge-orbit') : id === 'backend' ? import('@/lib/ascii/green-storm') : import('ascii.rest/pieces/earthrise')]);
     if (!dialog.open || request !== generation) return;
     const canvas = document.createElement('canvas');
     background.replaceChildren(canvas);
     stopBackground = mount(canvas, piece, { fps: 15 });
    } catch { /* El diagrama sigue disponible si no se puede cargar el fondo decorativo. */ }
   }
  });
  dialog.addEventListener('close', () => {
   generation++; stopBackground?.(); stopBackground = null;
   background?.replaceChildren();
   home.append(...Array.from(original.childNodes));
   document.documentElement.style.overflow = ''; button.focus({ preventScroll: true });
  });
 }
</script>
<style>
 #stack { max-width: 1440px; }
 #stack > h2 { text-align: center; font-size: clamp(2.5rem, 5vw, 4rem); }
 #stack > p { text-align: center; }
 .areas { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 2rem; list-style: none; margin: 0; padding: 0; }
 .area { grid-column: span 2; }
 .area:nth-child(4):nth-last-child(2) { grid-column: 2 / span 2; }
 .area { min-width: 0; }
 .preview { position: relative; isolation: isolate; padding-top: 2.75rem; }
 .preview-logo { position: absolute; z-index: -1; container-type: inline-size; opacity: 0.36; pointer-events: none; overflow: hidden; }
 .preview-logo[data-preview-logo='typescript'] { top: 8%; right: 3%; width: 30%; transform: rotate(-12deg); color: #3178c6; }
 .preview-logo[data-preview-logo='javascript'] { top: 13%; left: 4%; width: 23%; transform: rotate(10deg); color: #f5df50; }
 .preview-logo[data-preview-logo='html'] { bottom: 12%; left: 1%; width: 18%; transform: rotate(-10deg); color: #e44d26; }
 .preview-logo[data-preview-logo='css'] { bottom: 10%; right: 0; width: 18%; transform: rotate(12deg); color: #1572b6; }
 .preview-logo[data-preview-logo='php'] { bottom: 0; left: 35%; width: 30%; transform: rotate(-6deg); color: #777bb3; }
 .preview-logo[data-preview-logo='java'] { top: 9%; left: 2%; width: 23%; transform: rotate(-10deg); color: #ef2e2f; }
 .preview-logo[data-preview-logo='rust'] { top: 6%; right: 0; width: 29%; transform: rotate(10deg); color: #f74c00; }
 .preview-logo[data-preview-logo='lua'] { bottom: 9%; left: 0; width: 24%; transform: rotate(-12deg); color: #7777df; }
 .preview-logo[data-preview-logo='c'] { bottom: 0; right: 12%; width: 24%; transform: rotate(8deg); color: #659ad3; }
 .preview-logo pre { margin: 0; font: var(--logo-font)/1.2 monospace; white-space: pre; }
 .preview-logo :global(canvas) { display: block; width: 100%; height: auto; }
 .preview :global(.iso-plate-corners), .preview :global(figcaption) { display: none; }
 .preview :global(.fe-plate), .preview :global(.rd-plate) { padding: 0; }
 .open-area { position: absolute; inset: 0; width: 100%; border: 0; border-radius: 0.75rem; background: transparent; color: var(--fg); cursor: pointer; font: inherit; }
 .open-area span { position: absolute; top: 0; left: 0; width: 100%; text-align: center; font-weight: 600; }
 .open-area:hover, .open-area:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
 .figure-slot { min-width: 0; aspect-ratio: 4 / 3; }
 .figure-original { width: 100%; height: 100%; }
 .ascii-background { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: -1; display: grid; align-items: center; }
 .ascii-background :global(canvas) { display: block; width: 100%; height: auto; min-height: 100%; object-fit: cover; opacity: 0.8; }
 .ascii-scene { isolation: isolate; --bg: #030408; --fg: #f4f4f5; --muted: #d4d4d8; --border: #45454c; --surface: #151720; --accent: #93c5fd; color-scheme: dark; }
 .ascii-scene .diagram-view { border-radius: 0; background: transparent; }
 .ascii-scene :global(.iso-plate-corner), .ascii-scene :global(.fe-keys), .ascii-scene :global(.rd-keys), .ascii-scene :global(.be-caption), .ascii-scene :global(.be-keys) { color: #d4d4d8; text-shadow: 0 1px 3px #030408; }
 .ascii-scene .text { border-radius: 0.75rem; padding: 1rem; background: #030408e8; }
 .diagram-view { min-width: 0; width: 100%; max-width: calc((94dvh - 10rem) * 4 / 3); margin-inline: auto; }
 .diagram-view small { color: var(--muted); }
 .stack-dialog { position: fixed; inset: 0; margin: auto; width: min(1600px, 96vw); height: min(950px, 94dvh); max-width: 96vw; max-height: 94dvh; overscroll-behavior: contain; overflow: auto; padding: clamp(1rem, 2vw, 2rem); border: 1px solid var(--border); border-radius: 1rem; background: var(--bg); color: var(--fg); }
 .stack-dialog::backdrop { background: #0009; backdrop-filter: blur(6px); }
 .stack-dialog > form { position: sticky; top: 0; z-index: 2; display: flex; justify-content: end; pointer-events: none; }
 .stack-dialog > form button { pointer-events: auto; }
 .close-area { font: inherit; padding: 0.5rem 1rem; background: var(--surface); border: 1px solid var(--border); color: var(--fg); border-radius: 0.5rem; cursor: pointer; }
 .detail-layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1.4fr); gap: 2rem; align-items: center; min-height: calc(100% - 3rem); }
 h3 { margin: 0 0 0.5rem; font-size: 1.5rem; }
 p { color: var(--muted); }
 .techs { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; font: 0.8rem var(--font-mono); }
 .techs li { padding: 0.2rem 0.5rem; border: 1px solid var(--border); border-radius: 999px; }
 .techs li:has(.tech-button) { padding: 0; }
 .tech-button { padding: 0.2rem 0.5rem; border: 0; border-radius: inherit; background: transparent; color: inherit; font: inherit; cursor: pointer; }
 .tech-button:hover, .tech-button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
 .placeholder { display: grid; align-content: center; justify-items: center; height: 100%; background: var(--surface); color: var(--muted); border-radius: 0.75rem; }
 .placeholder small { display: block; }
 @media(max-width: 700px) { .areas, .detail-layout { grid-template-columns: 1fr; } .area, .area:nth-child(4):nth-last-child(2) { grid-column: auto; } .detail-layout { gap: 1.5rem; min-height: 0; padding-top: 1rem; } .diagram-view { max-width: none; } }
</style>
